{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Master": "Server=tcp:your-server.database.windows.net,1433;Database=Volta_Master;User ID=your-user;Password=SET_VIA_SECRET_STORE;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30",
    "TenantServerTemplate": "Server=tcp:your-server.database.windows.net,1433;Database={0};User ID=your-user;Password=SET_VIA_SECRET_STORE;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30",
    "Redis": ""
  },
  "AzureSql": {
    "UseManagementSdk": true,
    "SubscriptionId": "your-subscription-id",
    "ResourceGroupName": "your-resource-group",
    "ServerName": "your-sql-server",
    "Location": "Central India",
    "TenantPoolName": "Volta_Tenant_Pool"
  },
  "Jwt": {
    "Issuer": "volta-api",
    "Key": "SET_VIA_SECRET_STORE",
    "AccessMinutes": 15,
    "RefreshHours": 12
  },
  "Security": {
    "ConnectionKey": "SET_VIA_SECRET_STORE"
  },
  "Cors": {
    "Origins": [
      "https://your-frontend.example.com"
    ]
  },
  "Auth": {
    "LogOtpToConsole": false,
    "MaxFailedAttempts": 5,
    "LockMinutes": 5
  }
}
